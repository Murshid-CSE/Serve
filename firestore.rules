rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function validUser() {
      return request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role']) &&
             request.resource.data.name is string &&
             request.resource.data.name.size() > 0 &&
             request.resource.data.name.size() <= 100 &&
             request.resource.data.role in ['donor', 'volunteer', 'ngo', 'recipient', 'hospital'];
    }
    
    // Users
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && validUser();
      allow update: if isOwner(userId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['impactScore', 'reliabilityScore', 'role']);
      allow update: if isAdmin();
      allow delete: if isAdmin();
      
      // User notifications subcollection
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn();
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
    
    // Food Donations
    match /food_donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.donorId == request.auth.uid &&
        request.resource.data.status == 'available';
      allow update: if isSignedIn() && (
        (resource.data.donorId == request.auth.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['acceptedBy', 'acceptedByName', 'acceptedAt'])) ||
        (resource.data.status == 'available' && 
         request.resource.data.status == 'accepted' &&
         request.resource.data.acceptedBy == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedByName', 'acceptedAt', 'updatedAt'])) ||
        (resource.data.acceptedBy == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'collectedAt', 'deliveredAt', 'completedAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Blood Requests
    match /blood_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.requesterId == request.auth.uid;
      allow update: if isSignedIn() && (
        (resource.data.requesterId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['respondedBy', 'respondedByName'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respondedBy', 'status', 'updatedAt'])) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Volunteer Tasks
    match /volunteer_tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.volunteersJoined.size() == 0;
      allow update: if isSignedIn() && (
        (resource.data.creatorId == request.auth.uid && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorId', 'volunteersJoined'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['volunteersJoined']) &&
         (
           // Joining
           (request.resource.data.volunteersJoined.hasAll(resource.data.volunteersJoined) &&
            request.resource.data.volunteersJoined.hasAll([request.auth.uid]) &&
            request.resource.data.volunteersJoined.size() == resource.data.volunteersJoined.size() + 1 &&
            resource.data.volunteersJoined.size() < resource.data.volunteersNeeded) ||
           // Leaving
           (resource.data.volunteersJoined.hasAll(request.resource.data.volunteersJoined) &&
            resource.data.volunteersJoined.hasAll([request.auth.uid]) &&
            request.resource.data.volunteersJoined.size() == resource.data.volunteersJoined.size() - 1)
         )) ||
        isAdmin()
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.creatorId == request.auth.uid);
    }
    
    // Emergency Requests
    match /emergency_requests/{emergencyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responders']) &&
         request.resource.data.responders.hasAll(resource.data.responders) &&
         request.resource.data.responders.hasAll([request.auth.uid]) &&
         request.resource.data.responders.size() == resource.data.responders.size() + 1) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && 
        resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
